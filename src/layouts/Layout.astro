---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

// The two font files actually needed to paint above-the-fold text in their
// final weight: Fraunces 700 (the H1) and Inter 400 (body/hero-sub copy).
// Preloaded explicitly below, and given font-display: swap in the
// hand-authored @font-face block further down.
import frauncesBoldUrl from '@fontsource/fraunces/files/fraunces-latin-700-normal.woff2?url';
import interRegularUrl from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';

// Every other weight/subset the site uses, NOT preloaded and given
// font-display: optional instead of swap (see the rationale comment next to
// the generated <style> block below — this is what fixed the "Forced
// reflow" / 2.5s of Style & Layout main-thread time that showed up once the
// font setup moved from 3 variable files to ~20 static per-weight files).

export interface Props {
  title: string;
  description: string;
  path?: string;
  ogImage?: string;
  schema?: object[];
  noindex?: boolean;
  /** CSS selectors for the WebPage's speakable specification. Defaults to
   * just the H1, which every page has. Pages that render <ConverterHero />
   * (and therefore have a .hero-sub element) should pass
   * ['h1', '.hero-sub'] explicitly — hardcoding .hero-sub globally broke
   * structured-data validation on every page that doesn't render it (FAQ,
   * About, Contact, legal pages, etc.), since Speakable's cssSelector must
   * match a real element on the page. */
  speakableSelectors?: string[];
  /** ISO date (YYYY-MM-DD) this page's content was last materially updated.
   * Surfaced as WebPage.dateModified in structured data — AI answer engines
   * and Google's AI Overviews weight freshness when deciding what to cite,
   * so an accurate date here is a real (if modest) GEO/AEO signal. Defaults
   * to the same date already shown as "Last updated" on the legal pages;
   * bump this on a per-page basis (pass it explicitly) whenever that page's
   * actual content changes, rather than leaving every page on one fixed date
   * forever — a date that never moves is worse than no date at all. */
  dateModified?: string;
}

const {
  title,
  description,
  path = '/',
  ogImage = '/og-image.png',
  schema = [],
  noindex = false,
  speakableSelectors = ['h1'],
  dateModified = '2026-07-17',
} = Astro.props;

const site = Astro.site ?? new URL('https://usdtoworld.com');
const canonicalURL = new URL(path, site).toString();
const ogImageURL = new URL(ogImage, site).toString();

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('/#organization', site).toString(),
  name: 'UsdtoWorld',
  url: site.toString(),
  logo: new URL('/favicon/favicon-512.png', site).toString(),
  email: 'usdtoworld@gmail.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Office No. 202, P4, Ground, Shagun Tower, AB Rd, Near Vijay Nagar Square, Scheme 54 PU4',
    addressLocality: 'Indore',
    addressRegion: 'Madhya Pradesh',
    postalCode: '452010',
    addressCountry: 'IN',
  },
  // Only list profiles that are confirmed to actually exist — an invented
  // "plausible" handle here is worse than an empty array: it either 404s
  // (which is what an SEO crawl just flagged) or, worse, resolves to an
  // unrelated real account and misattributes this business to it.
  sameAs: ['https://x.com/usdtoworldkoj'],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': new URL('/#website', site).toString(),
  name: 'UsdtoWorld — USD to RMB Converter',
  url: site.toString(),
  inLanguage: 'en',
  publisher: { '@id': new URL('/#organization', site).toString() },
  // No potentialAction/SearchAction here: the site search (SiteSearch.astro)
  // is a client-side, in-page filter with no /search?q= results route
  // behind it, so declaring a SearchAction target would assert a URL that
  // 404s — same problem as the fabricated sameAs links from before, just in
  // a different schema field.
};

const speakableSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonicalURL}#webpage`,
  name: title,
  description,
  isPartOf: { '@id': new URL('/#website', site).toString() },
  inLanguage: 'en',
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: speakableSelectors,
  },
  url: canonicalURL,
  dateModified,
};

const allSchema = [organizationSchema, websiteSchema, speakableSchema, ...schema];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <link rel="preload" as="font" type="font/woff2" href={frauncesBoldUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interRegularUrl} crossorigin />




    <script is:inline>
      (function(){try{var K='usdtoworld:rates',T='usdtoworld:rates:time',c=localStorage.getItem(K),t=Number(localStorage.getItem(T)||0);if(!(c&&Date.now()-t<18e5)&&navigator.onLine){window.__ratesPromise=fetch('/api/rates').then(function(r){if(!r.ok)throw 0;return r.json()}).catch(function(){return fetch('https://open.er-api.com/v6/latest/USD').then(function(r){if(!r.ok)throw 0;return r.json()})}).then(function(d){if(!d.rates)throw 0;localStorage.setItem(K,JSON.stringify(d.rates));localStorage.setItem(T,String(Date.now()));return{rates:d.rates,time:Date.now(),offline:false}})}}catch(e){}})();
    </script>

    {/* Third-party scripts (Google Analytics + AdSense) are injected only after the
       visitor's first interaction, or after a 6s fallback. They previously loaded
       during page load and accounted for most of the main-thread blocking time. */}
    <script is:inline define:vars={{ adsEnabled: !noindex }}>
      (function(){var done=false;function add(src,cors){var e=document.createElement('script');e.async=true;e.src=src;if(cors)e.crossOrigin='anonymous';document.head.appendChild(e)}
      function load(){if(done)return;done=true;window.dataLayer=window.dataLayer||[];window.gtag=function(){dataLayer.push(arguments)};gtag('js',new Date());gtag('config','G-DXMLTX9F29');add('https://www.googletagmanager.com/gtag/js?id=G-DXMLTX9F29');if(adsEnabled)add('https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4088751665413869',true)}
      ['pointerdown','keydown','scroll','touchstart'].forEach(function(t){addEventListener(t,load,{once:true,passive:true})});setTimeout(load,6000)})();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="UsdtoWorld" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@usdtoworldkoj" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="alternate" hreflang="en" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />

    <meta name="theme-color" content="#3167e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14181f" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Usdtormb" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />

    <script is:inline>
      // Apply saved theme before paint to avoid flash-of-wrong-theme.
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    {allSchema.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <script>
      // Critical for correct visible state / immediate interactivity.
      import '../scripts/theme.js';
      import '../scripts/i18n.js';

      // Non-critical: deferred to idle time so they don't compete with the
      // user's first tap/click (e.g. opening the mobile nav) for main-thread
      // time right after load — this was showing up as elevated INP on
      // #mobile-nav>a in field data.
      const deferredScripts = () => {
        import('../scripts/scroll-top.js');
        import('../scripts/register-sw.js');
        import('../scripts/recent-pages.js');
      };
      if ('requestIdleCallback' in window) {
        requestIdleCallback(deferredScripts, { timeout: 2000 });
      } else {
        setTimeout(deferredScripts, 200);
      }
    </script>
  </body>
</html>
