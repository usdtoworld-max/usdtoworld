---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

// The two font files actually needed to paint above-the-fold text in their
// final weight: Fraunces 700 (the H1) and Inter 400 (body/hero-sub copy).
// Preloaded explicitly below, and given font-display: swap in the
// hand-authored @font-face block further down.
import frauncesBoldUrl from '@fontsource/fraunces/files/fraunces-latin-700-normal.woff2?url';
import interRegularUrl from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';

// Every other weight/subset the site uses, NOT preloaded and given
// font-display: optional instead of swap (see the rationale comment next to
// the generated <style> block below — this is what fixed the "Forced
// reflow" / 2.5s of Style & Layout main-thread time that showed up once the
// font setup moved from 3 variable files to ~20 static per-weight files).
import frauncesSemiboldUrl from '@fontsource/fraunces/files/fraunces-latin-600-normal.woff2?url';
import frauncesSemiboldExtUrl from '@fontsource/fraunces/files/fraunces-latin-ext-600-normal.woff2?url';
import frauncesBoldExtUrl from '@fontsource/fraunces/files/fraunces-latin-ext-700-normal.woff2?url';
import interRegularExtUrl from '@fontsource/inter/files/inter-latin-ext-400-normal.woff2?url';
import interMediumUrl from '@fontsource/inter/files/inter-latin-500-normal.woff2?url';
import interMediumExtUrl from '@fontsource/inter/files/inter-latin-ext-500-normal.woff2?url';
import interSemiboldUrl from '@fontsource/inter/files/inter-latin-600-normal.woff2?url';
import interSemiboldExtUrl from '@fontsource/inter/files/inter-latin-ext-600-normal.woff2?url';
import interBoldUrl from '@fontsource/inter/files/inter-latin-700-normal.woff2?url';
import interBoldExtUrl from '@fontsource/inter/files/inter-latin-ext-700-normal.woff2?url';
import monoRegularUrl from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import monoRegularExtUrl from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-ext-400-normal.woff2?url';
import monoMediumUrl from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url';
import monoMediumExtUrl from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-ext-500-normal.woff2?url';
import monoSemiboldUrl from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-600-normal.woff2?url';
import monoSemiboldExtUrl from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-ext-600-normal.woff2?url';
import monoBoldUrl from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-700-normal.woff2?url';
import monoBoldExtUrl from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-ext-700-normal.woff2?url';

export interface Props {
  title: string;
  description: string;
  path?: string;
  ogImage?: string;
  schema?: object[];
  noindex?: boolean;
  /** CSS selectors for the WebPage's speakable specification. Defaults to
   * just the H1, which every page has. Pages that render <ConverterHero />
   * (and therefore have a .hero-sub element) should pass
   * ['h1', '.hero-sub'] explicitly — hardcoding .hero-sub globally broke
   * structured-data validation on every page that doesn't render it (FAQ,
   * About, Contact, legal pages, etc.), since Speakable's cssSelector must
   * match a real element on the page. */
  speakableSelectors?: string[];
}

const {
  title,
  description,
  path = '/',
  ogImage = '/og-image.png',
  schema = [],
  noindex = false,
  speakableSelectors = ['h1'],
} = Astro.props;

const site = Astro.site ?? new URL('https://usdtoworld.com');
const canonicalURL = new URL(path, site).toString();
const ogImageURL = new URL(ogImage, site).toString();

// Unicode-range values match exactly what @fontsource ships for these two
// subsets — copied from node_modules so the browser's subset-matching
// behaves identically to the package CSS we're replacing.
const LATIN = 'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD';
const LATIN_EXT = 'U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF';

/** @type {{family: string, weight: number, url: string, range: string, display: 'swap' | 'optional'}[]} */
const fontFaces = [
  // Preloaded + critical to the LCP path -> swap (arrives fast, one cheap swap)
  { family: 'Fraunces', weight: 700, url: frauncesBoldUrl, range: LATIN, display: 'swap' },
  { family: 'Inter', weight: 400, url: interRegularUrl, range: LATIN, display: 'swap' },
  // Everything else -> optional (never causes a late swap/reflow; falls
  // back for this page view if it doesn't arrive almost immediately)
  { family: 'Fraunces', weight: 700, url: frauncesBoldExtUrl, range: LATIN_EXT, display: 'optional' },
  { family: 'Fraunces', weight: 600, url: frauncesSemiboldUrl, range: LATIN, display: 'optional' },
  { family: 'Fraunces', weight: 600, url: frauncesSemiboldExtUrl, range: LATIN_EXT, display: 'optional' },
  { family: 'Inter', weight: 400, url: interRegularExtUrl, range: LATIN_EXT, display: 'optional' },
  { family: 'Inter', weight: 500, url: interMediumUrl, range: LATIN, display: 'optional' },
  { family: 'Inter', weight: 500, url: interMediumExtUrl, range: LATIN_EXT, display: 'optional' },
  { family: 'Inter', weight: 600, url: interSemiboldUrl, range: LATIN, display: 'optional' },
  { family: 'Inter', weight: 600, url: interSemiboldExtUrl, range: LATIN_EXT, display: 'optional' },
  { family: 'Inter', weight: 700, url: interBoldUrl, range: LATIN, display: 'optional' },
  { family: 'Inter', weight: 700, url: interBoldExtUrl, range: LATIN_EXT, display: 'optional' },
  { family: 'IBM Plex Mono', weight: 400, url: monoRegularUrl, range: LATIN, display: 'optional' },
  { family: 'IBM Plex Mono', weight: 400, url: monoRegularExtUrl, range: LATIN_EXT, display: 'optional' },
  { family: 'IBM Plex Mono', weight: 500, url: monoMediumUrl, range: LATIN, display: 'optional' },
  { family: 'IBM Plex Mono', weight: 500, url: monoMediumExtUrl, range: LATIN_EXT, display: 'optional' },
  { family: 'IBM Plex Mono', weight: 600, url: monoSemiboldUrl, range: LATIN, display: 'optional' },
  { family: 'IBM Plex Mono', weight: 600, url: monoSemiboldExtUrl, range: LATIN_EXT, display: 'optional' },
  { family: 'IBM Plex Mono', weight: 700, url: monoBoldUrl, range: LATIN, display: 'optional' },
  { family: 'IBM Plex Mono', weight: 700, url: monoBoldExtUrl, range: LATIN_EXT, display: 'optional' },
];

const fontFaceCSS = fontFaces
  .map(
    (f) =>
      `@font-face{font-family:'${f.family}';font-style:normal;font-weight:${f.weight};font-display:${f.display};src:url(${f.url}) format('woff2');unicode-range:${f.range};}`
  )
  .join('\n');

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'UsdtoWorld',
  url: site.toString(),
  logo: new URL('/favicon/favicon-512.png', site).toString(),
  email: 'usdtoworld@gmail.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '93 2nd Ave',
    addressLocality: 'New York',
    addressRegion: 'NY',
    postalCode: '10003',
    addressCountry: 'US',
  },
  sameAs: [
    'https://x.com/usdtoworldkoj',
    'https://youtube.com/@usdtoworld',
    'https://facebook.com/usdtoworld',
    'https://instagram.com/usdtoworld',
    'https://linkedin.com/company/usdtoworld',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'UsdtoWorld — USD to RMB Converter',
  url: site.toString(),
  potentialAction: {
    '@type': 'SearchAction',
    target: `${site.toString()}search?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const speakableSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: speakableSelectors,
  },
  url: canonicalURL,
};

const allSchema = [organizationSchema, websiteSchema, speakableSchema, ...schema];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <!-- Preload the exact two font files needed to paint the H1 (Fraunces
         700) and body copy (Inter 400) in their final weight — deliberately
         first in <head>, ahead of the JSON-LD/meta block below, so these
         start downloading before anything else is even parsed. This is
         what actually fixes LCP; self-hosting alone wasn't enough because
         the bundled page CSS (which contains the @font-face rules) is
         injected at the very end of <head> by Astro, so without an
         explicit preload the browser wouldn't discover these files until
         everything above them had already been parsed. -->
    <link rel="preload" as="font" type="font/woff2" href={frauncesBoldUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interRegularUrl} crossorigin />

    <!-- Self-hosted @font-face rules for every weight the site uses.
         font-display is set per-file up in the `fontFaces` array above:
         swap for the two preloaded critical files (Fraunces 700 / Inter
         400), optional for everything else, to avoid late font-swap
         reflows. Injected via set:html (real JS-built CSS string) rather
         than a normal <style> block, because @font-face descriptors can't
         resolve CSS custom properties (define:vars doesn't work here —
         there's no element for @font-face to inherit a var() from). -->
    <style set:html={fontFaceCSS} />


    <!-- Fonts (Fraunces / Inter / IBM Plex Mono) are self-hosted, static
         per-weight, latin/latin-ext-only files pulled in via
         global.css -> fonts.css (bundled by Vite, served from this origin,
         cached immutably under /_astro/*). That removes the
         fonts.googleapis.com/fonts.gstatic.com round trips entirely instead
         of just trying to warm them up. See src/styles/fonts.css for the
         full rationale, including why static per-weight files were chosen
         over a variable font. -->

    <!-- Warm the connection to the rates API as early as possible. The
         network dependency tree showed the open.er-api.com fetch only
         starting after the whole module chain (Layout script -> dynamic
         import of converter.js) had loaded and parsed — ~360ms in, then
         taking another ~586ms critical-path total. Preconnecting here lets
         DNS/TLS finish in the background while the rest of the page is
         still being parsed, so by the time converter.js actually needs the
         data the handshake is already done. -->
    <link rel="preconnect" href="https://open.er-api.com" crossorigin />
    <script is:inline>
      // Kick the actual fetch off immediately too (not just DNS/TLS), using
      // the same cache keys/TTL as scripts/converter.js, and hand the
      // in-flight promise off via window.__ratesPromise. converter.js reads
      // this instead of starting its own fetch when present, so the request
      // and the JS module load happen in parallel instead of in sequence.
      (function () {
        try {
          var CACHE_KEY = 'usdtoworld:rates';
          var CACHE_TIME_KEY = 'usdtoworld:rates:time';
          var CACHE_TTL = 1000 * 60 * 30;
          var cached = localStorage.getItem(CACHE_KEY);
          var cachedTime = Number(localStorage.getItem(CACHE_TIME_KEY) || 0);
          var isFresh = cached && Date.now() - cachedTime < CACHE_TTL;
          if (!isFresh && navigator.onLine) {
            window.__ratesPromise = fetch('https://open.er-api.com/v6/latest/USD')
              .then(function (res) {
                if (!res.ok) throw new Error('bad-response');
                return res.json();
              })
              .then(function (data) {
                if (!data.rates) throw new Error('no-rates');
                localStorage.setItem(CACHE_KEY, JSON.stringify(data.rates));
                localStorage.setItem(CACHE_TIME_KEY, String(Date.now()));
                return { rates: data.rates, time: Date.now(), offline: false };
              });
          }
        } catch (e) {}
      })();
    </script>

    <!-- Google tag (gtag.js) — type="text/partytown" hands this off to the
         Partytown web worker (configured in astro.config.mjs) instead of
         running on the main thread. gtag.js reads window.dataLayer/gtag
         via proxied calls forwarded from the main thread, so behavior is
         unchanged — it just stops costing main-thread CPU time. -->
    <script type="text/partytown" src="https://www.googletagmanager.com/gtag/js?id=G-DXMLTX9F29"></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-DXMLTX9F29');
    </script>

    <!-- Partytown (above) creates its own sandbox <iframe> at runtime via
         document.createElement('iframe') to isolate gtag.js on a worker
         thread — that iframe ships with no title attribute, which is what
         an accessibility scan flags as "iframe required attributes
         missing". Partytown doesn't expose a config option for this, so we
         patch it as soon as it's inserted: watch for iframe nodes being
         added anywhere in the document, and if one has no title, mark it
         as a hidden, non-interactive sandbox rather than leaving it
         unlabeled for screen readers. Runs an immediate sweep first (in
         case the iframe already exists by the time this executes), then
         keeps observing for the rest of the page's life — Partytown loads
         and initializes its worker/sandbox lazily and asynchronously, and
         on a throttled connection (which is exactly what Lighthouse/PSI
         simulate) that can take well past a few seconds, so this
         deliberately does NOT auto-disconnect on a timer; a MutationObserver
         costs nothing while idle, so there's no ongoing overhead from
         leaving it attached. -->
    <script is:inline>
      (function () {
        function labelSandboxIframes(node) {
          if (!(node instanceof Element)) return;
          var frames = node.tagName === 'IFRAME' ? [node] : node.querySelectorAll ? node.querySelectorAll('iframe') : [];
          for (var i = 0; i < frames.length; i++) {
            var f = frames[i];
            if (!f.getAttribute('title')) {
              f.setAttribute('title', 'Third-party script sandbox');
              f.setAttribute('aria-hidden', 'true');
              f.setAttribute('tabindex', '-1');
            }
          }
        }
        try {
          labelSandboxIframes(document.body || document.documentElement);
          var observer = new MutationObserver(function (mutations) {
            for (var i = 0; i < mutations.length; i++) {
              var added = mutations[i].addedNodes;
              for (var j = 0; j < added.length; j++) labelSandboxIframes(added[j]);
            }
          });
          observer.observe(document.documentElement, { childList: true, subtree: true });
        } catch (e) {}
      })();
    </script>

    <!--
      Google AdSense: uncomment once approved and replace ca-pub-XXXXXXXXXXXXXXXX
      with your real publisher ID. public/ads.txt already has a matching placeholder line.
      <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX" crossorigin="anonymous"></script>
    -->

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="UsdtoWorld" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Hreflang (site is served in English with client-side UI translation) -->
    <link rel="alternate" hreflang="en" href={canonicalURL} />
    <link rel="alternate" hreflang="hi" href={canonicalURL} />
    <link rel="alternate" hreflang="zh" href={canonicalURL} />
    <link rel="alternate" hreflang="es" href={canonicalURL} />
    <link rel="alternate" hreflang="ja" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />

    <meta name="theme-color" content="#3167e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14181f" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Usdtormb" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />

    <script is:inline>
      // Apply saved theme before paint to avoid flash-of-wrong-theme.
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!-- Structured data: moved here from <head>. Google explicitly supports
         JSON-LD anywhere in the document (head or body) — see
         https://developers.google.com/search/docs/appearance/structured-data/intro-structured-data.
         The FAQ schema alone is several KB of inline script; keeping it out
         of <head> means the browser reaches the page's real CSS/font
         preloads sooner instead of parsing through this first. -->
    {allSchema.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <script>
      // Critical for correct visible state / immediate interactivity.
      import '../scripts/theme.js';
      import '../scripts/i18n.js';

      // Non-critical: deferred to idle time so they don't compete with the
      // user's first tap/click (e.g. opening the mobile nav) for main-thread
      // time right after load — this was showing up as elevated INP on
      // #mobile-nav>a in field data.
      const deferredScripts = () => {
        import('../scripts/scroll-top.js');
        import('../scripts/register-sw.js');
        import('../scripts/recent-pages.js');
      };
      if ('requestIdleCallback' in window) {
        requestIdleCallback(deferredScripts, { timeout: 2000 });
      } else {
        setTimeout(deferredScripts, 200);
      }
    </script>
  </body>
</html>
