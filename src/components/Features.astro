---
const features = [
  { icon: '📡', title: 'Real-time USD to RMB rates', copy: 'Rates refresh from a live market feed, so the number on screen reflects current trading conditions.' },
  { icon: '🌐', title: '180+ currencies beyond USD and RMB', copy: 'Beyond USD and RMB, convert between major and regional currencies including PKR, MXN, INR, and more.' },
  { icon: '🌓', title: 'Dark mode for USD to RMB checks', copy: 'A dedicated dark theme with cyan accents, easy on the eyes for late-night rate checks.' },
  { icon: '🗣️', title: 'USD to RMB in 5 languages', copy: 'Use the converter in English, Hindi, Chinese, Spanish, or Japanese.' },
  { icon: '📈', title: 'USD to RMB trend history', copy: 'See how a pair has moved over the past year at a glance before you convert.' },
  { icon: '⚡', title: 'Fast, lightweight page', copy: 'Built with Astro for a static, minimal-JS page that loads instantly on any connection.' },
];
---
<section class="section">
  <div class="container">
    <div class="section-head">
      <span class="section-eyebrow">Why UsdtoWorld</span>
      <h2>Why use this USD to RMB converter</h2>
      <p>Quick, trustworthy USD to RMB conversion, with 180+ other currencies when you need them.</p>
    </div>
    <div class="grid-3 feature-grid">
      {features.map((f) => (
        <div class="card feature-card">
          <span class="feature-icon" aria-hidden="true">{f.icon}</span>
          <h3>{f.title}</h3>
          <p>{f.copy}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .feature-card { display: flex; flex-direction: column; gap: 8px; }
  .feature-icon { font-size: 1.6rem; }
  .feature-card h3 { margin-bottom: 2px; }
  .feature-card p { margin-bottom: 0; font-size: 0.92rem; }
</style>
