---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { posts, wordCount } from '../../data/blog.js';
import { formatDate } from '../../utils/blog-markup.js';

const covers = import.meta.glob('../../assets/blog/*.jpg', { eager: true, import: 'default' });
const cover = (name) => covers[`../../assets/blog/${name}.jpg`];
const readTime = (p) => Math.max(1, Math.round(wordCount(p) / 200));

const site = Astro.site ?? new URL('https://usdtoworld.com');
const [featured, ...rest] = posts;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.toString() },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog', site).toString() },
  ],
};
const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'UsdtoWorld Blog',
  url: new URL('/blog', site).toString(),
  description: 'Guides to currency conversion, exchange rates and avoiding hidden costs.',
  publisher: { '@id': new URL('/#organization', site).toString() },
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.title,
    url: new URL(`/blog/${p.slug}`, site).toString(),
    datePublished: p.date,
  })),
};
---
<Layout
  title="Currency Conversion Blog: EUR, USD and INR Guides | UsdtoWorld"
  description="Plain-English guides to EUR a USD, 1 dollar to euro, Russian currency to INR and how exchange rates, margins and fees really work."
  path="/blog"
  schema={[breadcrumbSchema, blogSchema]}
  dateModified="2026-10-07"
>
  <div class="container page-hero">
    <Breadcrumbs trail={[{ name: 'Home', href: '/' }, { name: 'Blog', href: '/blog' }]} />
  </div>

  <section class="section section--tight">
    <div class="container">
      <span class="section-eyebrow">The UsdtoWorld blog</span>
      <h1 class="blog-title">Currency guides that explain the number, not just show it</h1>
      <p class="blog-lede">Practical articles on converting euros, dollars, rubles and rupees, and on the fees and market forces that change what you actually receive.</p>

      <a class="blog-hero" href={`/blog/${featured.slug}`}>
        <Image
          src={cover(featured.image)}
          alt={featured.imageAlt}
          widths={[640, 1200]}
          sizes="(min-width: 900px) 55vw, 100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="blog-hero__body">
          <span class="blog-tag">Featured · {featured.category}</span>
          <h2>{featured.title}</h2>
          <p>{featured.description}</p>
          <span class="blog-meta">{formatDate(featured.date)} · {readTime(featured)} min read</span>
        </div>
      </a>

      <h2 class="blog-sub">More guides</h2>
      <div class="blog-grid">
        {rest.map((p) => (
          <a class="blog-card" href={`/blog/${p.slug}`}>
            <Image
              src={cover(p.image)}
              alt={p.imageAlt}
              widths={[480]}
              sizes="(min-width: 900px) 25vw, (min-width: 600px) 50vw, 100vw"
              loading="lazy"
              decoding="async"
            />
            <div class="blog-card__body">
              <span class="blog-tag">{p.category}</span>
              <h3>{p.title}</h3>
              <p>{p.description}</p>
              <span class="blog-meta">{formatDate(p.date)} · {readTime(p) } min read</span>
            </div>
          </a>
        ))}
      </div>

      <section class="blog-about prose">
        <h2>How to use these guides</h2>
        <p>
          Each article starts from a question people really search for, such as how to convert EUR a USD, what
          1 dollar to euro means in practice, or how to turn Russian currency into INR, and ends with a way to check
          the answer yourself. Example rates inside the articles are always labelled as illustrative, because exchange
          rates move every few seconds. When you need a current figure, open the matching live converter and enter
          your own amount.
        </p>
        <p>
          If you already know the pair you need, go straight to the
          <a href="/eur-to-usd">EUR to USD</a>, <a href="/usd-to-eur">USD to EUR</a> or
          <a href="/russian-currency-to-inr">RUB to INR</a> converter, or browse the
          <a href="/currency-converters">complete list of currency converters</a>. Questions about how rates are
          sourced and calculated are answered on the <a href="/faq">FAQ page</a> and in the
          <a href="/about">About page</a>, and you can tell us which topic to cover next through the
          <a href="/contact">Contact page</a>.
        </p>
      </section>
    </div>
  </section>
</Layout>

<style>
  .blog-title { font-size: clamp(1.9rem, 4vw, 2.8rem); max-width: 22ch; margin: 6px 0 14px; }
  .blog-lede { color: var(--text-muted); max-width: 60ch; margin-bottom: 36px; }
  .blog-tag { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
  .blog-meta { font-size: 0.82rem; color: var(--text-muted); }
  .blog-hero, .blog-card {
    display: flex; background: var(--surface-solid); border: 1px solid var(--border);
    border-radius: var(--radius-md); overflow: hidden; color: inherit;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .blog-hero:hover, .blog-card:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .blog-hero { flex-direction: row; margin-bottom: 48px; }
  .blog-hero img { width: 55%; height: auto; aspect-ratio: 1200 / 630; object-fit: cover; display: block; }
  .blog-hero__body { padding: 32px; display: flex; flex-direction: column; gap: 12px; justify-content: center; }
  .blog-hero__body h2 { font-size: clamp(1.4rem, 2.4vw, 2rem); margin: 0; }
  .blog-hero__body p, .blog-card__body p { margin: 0; color: var(--text-muted); }
  .blog-about { margin-top: 56px; }
  .blog-sub { font-size: 1.3rem; margin-bottom: 18px; }
  .blog-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 22px; }
  .blog-card { flex-direction: column; }
  .blog-card img { width: 100%; height: auto; aspect-ratio: 1200 / 630; object-fit: cover; display: block; }
  .blog-card__body { padding: 20px; display: flex; flex-direction: column; gap: 10px; }
  .blog-card__body h3 { font-size: 1.1rem; margin: 0; line-height: 1.3; }
  @media (max-width: 820px) {
    .blog-hero { flex-direction: column; }
    .blog-hero img { width: 100%; }
    .blog-hero__body { padding: 22px; }
  }
</style>
