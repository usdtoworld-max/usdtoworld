---
import Layout from '../layouts/Layout.astro';
import ConverterHero from '../components/ConverterHero.astro';
// scripts imported in <script> block below
import Features from '../components/Features.astro';
import CurrencyGuides from '../components/CurrencyGuides.astro';
import RateChart from '../components/RateChart.astro';
import EditorialSections from '../components/EditorialSections.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import AmountTable from '../components/AmountTable.astro';
import { faqs } from '../data/faq.js';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

---
<Layout
  title="USD to RMB Currency Calculator — Live Exchange | UsdtoWorld"
  description="Free live USD to RMB currency calculator. Check 1 USD to RMB, 1000 USD to RMB, historical trends, and converters for INR, EUR, GBP, JPY, and more."
  path="/"
  schema={[faqSchema]}
  speakableSelectors={['h1', '.hero-sub']}
>
  <ConverterHero useI18n={true} />

  <div class="container">
    <p class="amount-table-intro">Common USD to RMB (Chinese Yuan) amounts, worked out below:</p>
    <AmountTable
      fromCode="USD"
      toCode="CNY"
      fromSymbol="$"
      toSymbol="¥"
      rate={6.757}
      amounts={[10, 100, 500, 1000, 5000]}
      asOfDate="2026-08-14"
    />
  </div>

  <Features />
  <CurrencyGuides />
  <RateChart />
  <EditorialSections />
  <FAQAccordion showViewAllLink={true} />

  <script>
    import '../scripts/converter.js';
  </script>
</Layout>
