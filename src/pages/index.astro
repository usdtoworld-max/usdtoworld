---
import Layout from '../layouts/Layout.astro';
import ConverterHero from '../components/ConverterHero.astro';
// scripts imported in <script> block below
import Features from '../components/Features.astro';
import CurrencyGuides from '../components/CurrencyGuides.astro';
import RateChart from '../components/RateChart.astro';
import EditorialSections from '../components/EditorialSections.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import AmountTable from '../components/AmountTable.astro';
import { faqs } from '../data/faq.js';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

---
<Layout
  title="USD to RMB Converter: Live Dollar to Yuan Rate | UsdtoWorld"
  description="Convert USD to RMB with a live exchange rate. Check 1 USD to RMB, 1000 USD to RMB, 12-month trends and what moves the dollar to yuan rate."
  path="/"
  schema={[faqSchema]}
  speakableSelectors={['h1', '.hero-sub']}
>
  <ConverterHero useI18n={true} />

  <div class="container">
    <p class="amount-table-intro">Common USD to RMB (Chinese Yuan) amounts, worked out below:</p>
    <AmountTable
      fromCode="USD"
      toCode="CNY"
      fromSymbol="$"
      toSymbol="¥"
      rate={6.757}
      amounts={[10, 100, 500, 1000, 5000]}
      asOfDate="2026-08-14"
    />
  </div>

  <section class="section section--tight">
    <div class="container prose">
      <h2>How to convert USD to RMB</h2>
      <p>
        To convert USD to RMB, multiply the dollar amount by the current USD to RMB exchange rate. The result is the
        value in Chinese yuan (CNY). For example, at an illustrative rate of 7.00, 100 USD is 700 RMB; to go back,
        divide the yuan amount by the same rate.
      </p>
      <ol>
        <li>Enter the amount in US dollars in the converter above.</li>
        <li>Check that USD is selected as the "From" currency and CNY (RMB) as the "To" currency.</li>
        <li>Read the live result, then compare it with the offer from your bank or transfer provider.</li>
      </ol>
      <p>
        Banks and exchange services usually add a margin to the mid-market rate shown here, so the yuan you receive
        can be slightly lower than the converter result. Our guide to
        <a href="/blog/mid-market-vs-bank-exchange-rate">mid-market and bank exchange rates</a> shows how to work out
        the real cost.
      </p>
    </div>
  </section>

  <Features />
  <CurrencyGuides />
  <RateChart />
  <EditorialSections />
  <FAQAccordion showViewAllLink={true} />

  <script>
    import '../scripts/converter.js';
  </script>
</Layout>
