---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const site = Astro.site ?? new URL('https://usdtoworld.com');
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.toString() },
    { '@type': 'ListItem', position: 2, name: 'Contact Us', item: new URL('/contact', site).toString() },
  ],
};
---
<Layout
  title="Contact Us | UsdtoWorld"
  description="Get in touch with the UsdtoWorld team with questions, feedback, or currency pair requests."
  path="/contact"
  schema={[breadcrumbSchema]}
>
  <div class="container page-hero">
    <Breadcrumbs trail={[{ name: 'Home', href: '/' }, { name: 'Contact Us', href: '/contact' }]} />
  </div>
  <section class="section section--tight">
    <div class="container contact-grid">
      <div>
        <span class="section-eyebrow">Contact</span>
        <h1>We'd like to hear from you</h1>
        <p>
          Spotted an incorrect rate, want a currency pair added, or have general feedback? Send us a message
          and we'll get back to you.
        </p>
        <ul class="contact-meta">
          <li><strong>Email:</strong> usdtoworld@gmail.com</li>
          <li><strong>Response time:</strong> Usually within 2 business days</li>
          <li><strong>Address:</strong> 93 2nd Ave, New York, United States, 10003</li>
        </ul>
      </div>

      <form class="card contact-form" data-contact-form>
        <h2 class="visually-hidden">Send us a message</h2>
        <div>
          <label for="c-name">Name</label>
          <input id="c-name" name="name" type="text" required />
        </div>
        <div>
          <label for="c-email">Email</label>
          <input id="c-email" name="email" type="email" required />
        </div>
        <div>
          <label for="c-message">Message</label>
          <textarea id="c-message" name="message" required></textarea>
        </div>
        <!-- Honeypot: hidden from real visitors via CSS below; bots that fill
             every field trip it, and worker/index.js silently no-ops on it. -->
        <div class="contact-form__hp" aria-hidden="true">
          <label for="c-company">Company</label>
          <input id="c-company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <button type="submit" class="btn btn-primary" data-submit-btn>Send message</button>
        <p data-form-msg hidden class="newsletter-msg"></p>
      </form>
    </div>

    <div class="container contact-more prose">
      <h2>What to include in your message</h2>
      <p>
        A few details help us reply faster and get to the right fix sooner:
      </p>
      <ul>
        <li><strong>Reporting a wrong rate?</strong> Tell us the currency pair, the rate you saw, and roughly when you saw it.</li>
        <li><strong>Requesting a new currency pair?</strong> Name the pair (for example, USD to MXN) and, if it's helpful, why you need it — travel, remittances, business invoicing, and so on.</li>
        <li><strong>Found something wrong on a guide page?</strong> Link the page and quote the sentence that looks off. We check every report before changing anything, and corrections go straight onto the live page rather than sitting in a queue.</li>
        <li><strong>General feedback or a bug report?</strong> Screenshots and the browser or device you were using make it much faster for us to reproduce and fix.</li>
      </ul>

      <h2>What we can't help with</h2>
      <p>
        UsdtoWorld is a converter and information site, not a bank, broker, or money transfer service — see
        our <a href="/disclaimer">disclaimer</a> for the full picture. We can't move money on your behalf,
        access your bank or transfer accounts, or give personalized financial or tax advice. For an actual
        transfer or account issue, you'll need to contact your bank or transfer provider directly; we're
        happy to help with anything about the rates or content on this site itself.
      </p>
    </div>
  </section>

  <script>
    const form = document.querySelector('[data-contact-form]');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('[data-submit-btn]');
      const msgEl = form.querySelector('[data-form-msg]');
      const payload = Object.fromEntries(new FormData(form).entries());

      btn.disabled = true;
      btn.textContent = 'Sending…';
      msgEl.hidden = true;

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));

        if (res.ok && data.ok) {
          form.reset();
          msgEl.textContent = "Thanks — your message is on its way. We'll reply soon.";
          msgEl.dataset.tone = 'success';
        } else {
          throw new Error(data.error || 'send_failed');
        }
      } catch (err) {
        msgEl.textContent = "Note: Please email us directly at usdtoworld@gmail.com instead.";
        msgEl.dataset.tone = 'error';
      } finally {
        btn.disabled = false;
        btn.textContent = 'Send message';
        msgEl.hidden = false;
      }
    });
  </script>
</Layout>

<style>
  .contact-meta { list-style: none; padding: 0; margin-top: 20px; display: flex; flex-direction: column; gap: 8px; font-size: 0.92rem; }
  .contact-more { margin-top: 56px; }
  .contact-form__hp { position: absolute; width: 1px; height: 1px; overflow: hidden; opacity: 0; pointer-events: none; }
  .newsletter-msg[data-tone='error'] { color: var(--danger, #d92d20); }
</style>
