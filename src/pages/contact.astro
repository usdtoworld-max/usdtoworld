---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const site = Astro.site ?? new URL('https://usdtoworld.com');
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.toString() },
    { '@type': 'ListItem', position: 2, name: 'Contact Us', item: new URL('/contact', site).toString() },
  ],
};
---
<Layout
  title="Contact Us | UsdtoWorld"
  description="Get in touch with the UsdtoWorld team with questions, feedback, or currency pair requests."
  path="/contact"
  schema={[breadcrumbSchema]}
>
  <div class="container page-hero">
    <Breadcrumbs trail={[{ name: 'Home', href: '/' }, { name: 'Contact Us', href: '/contact' }]} />
  </div>
  <section class="section section--tight">
    <div class="container contact-grid">
      <div>
        <span class="section-eyebrow">Contact</span>
        <h1>We'd like to hear from you</h1>
        <p>
          Spotted an incorrect rate, want a currency pair added, or have general feedback? Send us a message
          and we'll get back to you.
        </p>
        <ul class="contact-meta">
          <li><strong>Email:</strong> usdtoworld@gmail.com</li>
          <li><strong>Response time:</strong> Usually within 2 business days</li>
          <li><strong>Address:</strong> Office No. 202, P4, Ground, Shagun Tower, AB Rd, Near Vijay Nagar Square, Scheme 54 PU4, Indore, Madhya Pradesh 452010, India</li>
        </ul>
      </div>

      <form class="card contact-form" data-contact-form>
        <h2 class="visually-hidden">Send us a message</h2>
        <div>
          <label for="c-name">Name</label>
          <input id="c-name" name="name" type="text" required />
        </div>
        <div>
          <label for="c-email">Email</label>
          <input id="c-email" name="email" type="email" required />
        </div>
        <div>
          <label for="c-message">Message</label>
          <textarea id="c-message" name="message" required></textarea>
        </div>
        <div class="contact-form__hp" aria-hidden="true">
          <label for="c-company">Company</label>
          <input id="c-company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <button type="submit" class="btn btn-primary" data-submit-btn>Send message</button>
        <p data-form-msg hidden class="newsletter-msg"></p>
      </form>
    </div>

    <div class="container contact-more prose">
      <h2>What to include in your message</h2>
      <p>
        A few details help us reply faster and get to the right fix sooner:
      </p>
      <ul>
        <li><strong>Reporting a wrong rate?</strong> Tell us the currency pair, the rate you saw, and roughly when you saw it.</li>
        <li><strong>Requesting a new currency pair?</strong> Name the pair (for example, USD to MXN) and, if it's helpful, why you need it — travel, remittances, business invoicing, and so on.</li>
        <li><strong>Found something wrong on a guide page?</strong> Link the page and quote the sentence that looks off. We check every report before changing anything, and corrections go straight onto the live page rather than sitting in a queue.</li>
        <li><strong>General feedback or a bug report?</strong> Screenshots and the browser or device you were using make it much faster for us to reproduce and fix.</li>
      </ul>

      <h2>What we can't help with</h2>
      <p>
        UsdtoWorld is a converter and information site, not a bank, broker, or money transfer service — see
        our <a href="/disclaimer">disclaimer</a> for the full picture. We can't move money on your behalf,
        access your bank or transfer accounts, or give personalized financial or tax advice. For an actual
        transfer or account issue, you'll need to contact your bank or transfer provider directly; we're
        happy to help with anything about the rates or content on this site itself.
      </p>

      <h2>What happens after you write</h2>
      <p>
        Messages sent through the form or to usdtoworld@gmail.com are read by a person, not an auto-responder.
        We aim to reply within two business days. If you report an error, we check it before changing anything,
        and when it is confirmed we correct the live page. Questions that
        need a longer answer, such as how a rate is calculated, may get a pointer to the relevant guide so you have
        the explanation in writing.
      </p>

      <h2>If a page looks out of date or a rate looks stuck</h2>
      <p>
        To work offline and load quickly, the site keeps copies of pages and the last rate you fetched in your
        browser. If something looks stale, reload the page once or twice, or clear this site's data in your browser
        settings, and check whether the live converter shows a fresh time. If the problem persists, include your
        device, browser and the page address in your message, because those three details usually let us reproduce
        a fault straight away.
      </p>

      <h2>Quick answers before you write</h2>
      <p>
        Many questions are already answered on the site. The <a href="/faq">FAQ</a> covers common questions about
        rates, conversion maths and transfers. Each pair guide, from <a href="/usd-to-inr">USD to INR</a> to
        <a href="/russian-currency-to-inr">RUB to INR</a>, explains what moves that rate. The
        <a href="/currency-converters">converters index</a> lists every pair, and the <a href="/about">About page</a>
        explains where our rates come from and who writes and reviews the guides.
      </p>

      <h2>Tips for a faster reply, and what not to send</h2>
      <p>
        Keep each message to one topic, give it a clear first line, and say which page or converter you were using.
        If your question is about a conversion, include the amount and the two currencies, for example 500 EUR to
        USD, so we can check the same figure on our side. Please do not send passwords, card numbers, bank account
        details or copies of identity documents by form or email; we never need them, and we will not ask for
        them. If you are unsure whether something is safe to share, leave it out and describe the problem in words.
      </p>

      <h2>Privacy requests, press and business enquiries</h2>
      <p>
        To ask us to delete or correct something you sent us, write to the same address and mention that it is a
        privacy request; our <a href="/privacy-policy">Privacy Policy</a> explains what we hold and for how long.
        Journalists, researchers and site owners who want to cite or link to our guides, or ask about permission to
        reuse content, are welcome to get in touch using the same form or email, and it helps to include your
        organisation and what you plan to publish. We are a small independent site, so a clear, specific message
        gets the fastest and most useful reply.
      </p>
    </div>
  </section>

  <script>
    const form = document.querySelector('[data-contact-form]');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('[data-submit-btn]');
      const msgEl = form.querySelector('[data-form-msg]');
      const payload = Object.fromEntries(new FormData(form).entries());

      btn.disabled = true;
      btn.textContent = 'Sending…';
      msgEl.hidden = true;

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));

        if (res.ok && data.ok) {
          form.reset();
          msgEl.textContent = "Thanks — your message is on its way. We'll reply soon.";
          msgEl.dataset.tone = 'success';
        } else {
          throw new Error(data.error || 'send_failed');
        }
      } catch (err) {
        msgEl.textContent = "Note: Please email us directly at usdtoworld@gmail.com instead.";
        msgEl.dataset.tone = 'error';
      } finally {
        btn.disabled = false;
        btn.textContent = 'Send message';
        msgEl.hidden = false;
      }
    });
  </script>
</Layout>

<style>
  .contact-meta { list-style: none; padding: 0; margin-top: 20px; display: flex; flex-direction: column; gap: 8px; font-size: 0.92rem; }
  .contact-more { margin-top: 56px; }
  .contact-form__hp { position: absolute; width: 1px; height: 1px; overflow: hidden; opacity: 0; pointer-events: none; }
  .newsletter-msg[data-tone='error'] { color: var(--danger, #d92d20); }
</style>
